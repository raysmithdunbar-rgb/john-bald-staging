---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Tailwind width class for the photo column on wider screens. */
  photoWidth?: string;
}

const { src, alt, photoWidth = 'sm:w-56' } = Astro.props;
---

<!-- A person's photograph beside their own section. Stacks on a phone. -->
<div class="my-8 flex flex-col gap-6 sm:flex-row sm:items-start">
  <figure class={`w-full max-w-xs shrink-0 border border-line bg-cream p-1.5 ${photoWidth}`}>
    <Image
      src={src}
      alt={alt}
      widths={[320, 480, 640]}
      sizes="320px"
      class="block h-auto w-full"
      loading="lazy"
    />
  </figure>
  <div class="min-w-0 [&>*+*]:mt-4 [&>h2]:mt-0">
    <slot />
  </div>
</div>
