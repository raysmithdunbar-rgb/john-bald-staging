---
import { SITE, ACTIVE_ADDRESS, CONTACT, MEMBERSHIPS, SOCIAL } from '../data/site';
import { PRIMARY_NAV, FOOTER_LEGAL } from '../data/nav';

const verifiedMemberships = MEMBERSHIPS.filter((m) => m.verified);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t-4 border-gold bg-maroon text-paper">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-12 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <p class="font-serif text-2xl text-paper">John Bald Funeral Directors</p>
        <p class="mt-2 font-display text-3xl leading-none text-gold">{SITE.tagline}</p>

        <address class="mt-6 not-italic text-paper/85">
          {ACTIVE_ADDRESS.street}<br />
          {ACTIVE_ADDRESS.locality}<br />
          {ACTIVE_ADDRESS.region} {ACTIVE_ADDRESS.postcode}
        </address>

        <p class="mt-4">
          <a href={CONTACT.phoneHref} class="text-lg font-semibold no-underline">
            {CONTACT.phone}
          </a><br />
          <span class="text-sm text-paper/70">{CONTACT.hours}</span>
        </p>

        <p class="mt-3">
          <a href={`mailto:${CONTACT.email}`} class="text-sm">{CONTACT.email}</a>
        </p>

        {
          SOCIAL.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-5">
              {SOCIAL.map((profile) => (
                <li>
                  <a
                    href={profile.url}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 text-sm text-paper/85 no-underline hover:underline"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="20"
                      height="20"
                      fill="currentColor"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.49 0-1.95.93-1.95 1.87v2.25h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07z" />
                    </svg>
                    {profile.name}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <nav aria-label="Footer">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-paper/70">
          Pages
        </h2>
        <ul class="mt-4 space-y-2">
          {
            PRIMARY_NAV.map((item) => (
              <li>
                <a href={item.href} class="text-paper/85 no-underline hover:underline">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-widest text-paper/70">
          Prices
        </h2>
        <ul class="mt-4 space-y-2">
          <li>
            <a
              href="/funeral-costs/standardised-price-list/"
              class="text-paper/85 no-underline hover:underline"
            >
              Standardised Price List
            </a>
          </li>
          <li>
            <a
              href="/funeral-costs/additional-options-price-list/"
              class="text-paper/85 no-underline hover:underline"
            >
              Additional Options Price List
            </a>
          </li>
          <li>
            <a
              href="/funeral-costs/help-with-funeral-costs/"
              class="text-paper/85 no-underline hover:underline"
            >
              Help with funeral costs
            </a>
          </li>
        </ul>

        {
          verifiedMemberships.length > 0 && (
            <>
              <h2 class="mt-8 text-sm font-semibold uppercase tracking-widest text-paper/70">
                Members of
              </h2>
              <ul class="mt-4 space-y-2 text-sm text-paper/85">
                {verifiedMemberships.map((m) => (
                  <li>
                    {m.name} <span class="text-paper/70">({m.abbr} {m.number})</span>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-paper/25 pt-8 text-sm text-paper/70 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        &copy; {year} John Bald Funeral Directors. Part of the {SITE.parentCompany} family of
        independent funeral directors.
      </p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          FOOTER_LEGAL.map((item) => (
            <li>
              <a href={item.href} class="text-paper/70 no-underline hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
