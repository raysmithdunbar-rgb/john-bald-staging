---
import { Image } from 'astro:assets';
import logo from '../assets/brand/john-bald-logo-poppies.png';
import harbour from '../assets/photos/dunbar-harbour.jpg';
import { SITE, CONTACT } from '../data/site';
import { PRIMARY_NAV } from '../data/nav';

const path = Astro.url.pathname;
const isHome = path === '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="border-b border-line bg-paper">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-3 focus:text-paper"
  >
    Skip to content
  </a>

  <!--
    Every page opens on the harbour photograph with the logo and number in a
    light circle, centred. The home page gets the full-height version; inner
    pages get a slim band with a smaller circle, so the page content is not
    pushed down. The number stays visible above the fold on every page: this
    site leads with an at-need journey, which is why it is in the circle at all
    (the parent site, Doyle, carries no number in its header).
  -->
  <div
    class={isHome
      ? 'relative isolate flex items-center justify-center px-5 py-6 sm:min-h-[30rem] sm:py-10'
      : 'relative isolate flex items-center justify-center px-5 py-4 sm:py-6'}
  >
    <Image
      src={harbour}
      alt={isHome
        ? 'Dunbar Harbour on a busy day, with fishing boats and lobster creels at the quay, the harbourside houses behind and the castle ruins on the red rocks beyond.'
        : ''}
      widths={[720, 1280, 1920, 2200]}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-[60%_45%] sm:object-[center_42%]"
      loading="eager"
      fetchpriority="high"
    />

    <div
      class={`flex aspect-square flex-col items-center justify-center rounded-full border-2 border-gold bg-paper/95 text-center shadow-xl ${
        isHome ? 'w-64 sm:w-80' : 'w-44 sm:w-52'
      }`}
    >
      <!--
        The logo is a full lockup — it already carries "John Bald / Funeral
        Directors", so there is no text wordmark beside it to duplicate. The alt
        text supplies that wording to screen readers and to anyone browsing with
        images off.
      -->
      <a href="/" class="mx-auto block w-fit no-underline" aria-label={`${SITE.name} — home`}>
        <Image
          src={logo}
          alt={SITE.name}
          widths={[200, 320, 480]}
          sizes="(min-width: 640px) 208px, 144px"
          class={isHome ? 'h-auto w-36 sm:w-52' : 'h-auto w-24 sm:w-32'}
          loading="eager"
          fetchpriority="high"
        />
      </a>

      <div class={isHome ? 'mt-3 text-center' : 'mt-1 text-center sm:mt-2'}>
        <a
          href={CONTACT.phoneHref}
          class={`font-serif font-semibold text-poppy-deep no-underline hover:text-poppy ${
            isHome ? 'text-xl sm:text-2xl' : 'text-base sm:text-xl'
          }`}
        >
          {CONTACT.phone}
        </a>
        <span class={`mt-1 text-xs text-ink-muted ${isHome ? 'block' : 'hidden sm:block'}`}>
          Day or night, any day
        </span>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="my-5 flex justify-center lg:hidden">
      <!-- Native disclosure: no JavaScript, keyboard and screen-reader accessible by default. -->
      <details class="jb-menu">
        <summary
          class="flex cursor-pointer list-none items-center gap-2 rounded border border-line px-4 py-2 text-sm"
        >
          <span aria-hidden="true">☰</span> Menu
        </summary>
        <nav
          aria-label="Main"
          class="absolute inset-x-0 z-40 mt-4 border-y border-line bg-cream px-5 py-4 shadow-lg sm:px-8"
        >
          <ul class="mx-auto max-w-6xl">
            {
              PRIMARY_NAV.map((item) => (
                <li class="border-b border-line last:border-0">
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    class="block py-3 text-lg no-underline aria-[current=page]:font-semibold"
                  >
                    {item.label}
                  </a>
                  {item.children && (
                    <ul class="mb-3 ml-4 border-l border-gold pl-4">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            aria-current={path === child.href ? 'page' : undefined}
                            class="block py-2 text-base text-ink-soft no-underline aria-[current=page]:font-semibold aria-[current=page]:text-ink"
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>

  <!--
    Dropdowns open on hover, on keyboard focus, and on the small arrow button
    (for touch screens and screen readers). The parent label stays a real link,
    so with scripts off every sub page is still one click further on from the
    parent page.
  -->
  <nav aria-label="Main" class="relative z-30 hidden border-t border-line lg:block">
    <ul class="mx-auto flex max-w-6xl flex-wrap justify-center gap-x-6 px-8">
      {
        PRIMARY_NAV.map((item, i) => (
          <li class="jb-item group relative">
            <div class="flex items-center">
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="-mb-px block border-b-2 border-transparent py-3 pl-1 pr-1 text-[0.95rem] text-ink-soft no-underline hover:border-poppy hover:text-ink aria-[current=page]:border-poppy aria-[current=page]:text-ink"
              >
                {item.label}
              </a>
              {item.children && (
                <button
                  type="button"
                  class="jb-toggle -mb-px border-b-2 border-transparent px-1 py-3 text-xs text-ink-muted hover:text-ink"
                  aria-expanded="false"
                  aria-controls={`jb-sub-${i}`}
                  aria-label={`Show pages under ${item.label}`}
                >
                  <span aria-hidden="true">▾</span>
                </button>
              )}
            </div>
            {item.children && (
              <ul
                id={`jb-sub-${i}`}
                class="jb-sub invisible absolute left-0 top-full z-40 min-w-64 border border-line border-t-gold bg-paper py-2 opacity-0 shadow-lg transition-opacity duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
                style="border-top-width:2px"
              >
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={path === child.href ? 'page' : undefined}
                      class="block px-5 py-2 text-[0.95rem] text-ink-soft no-underline hover:bg-cream hover:text-ink aria-[current=page]:font-semibold aria-[current=page]:text-ink"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Arrow buttons: open or close a dropdown for touch and screen-reader users.
  // Hover and keyboard focus are handled in CSS and need none of this.
  const items = document.querySelectorAll<HTMLElement>('.jb-item');

  function close(item: HTMLElement) {
    item.classList.remove('jb-open');
    item.querySelector('.jb-toggle')?.setAttribute('aria-expanded', 'false');
  }

  items.forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('.jb-toggle');
    toggle?.addEventListener('click', () => {
      const opening = !item.classList.contains('jb-open');
      items.forEach(close);
      if (opening) {
        item.classList.add('jb-open');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.jb-item')) items.forEach(close);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') items.forEach(close);
  });
</script>

<style>
  .jb-menu > summary::-webkit-details-marker {
    display: none;
  }</style>
