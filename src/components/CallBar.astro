---
import { CONTACT } from '../data/site';
---

<!--
  Fixed on small screens only. Someone reaching this site at 3am on a phone
  should never have to scroll to find the number.
-->
<div
  class="fixed inset-x-0 bottom-0 z-30 border-t border-poppy-deep bg-poppy text-center shadow-lg lg:hidden"
>
  <a
    href={CONTACT.phoneHref}
    class="block px-4 py-4 text-lg font-semibold text-white no-underline"
  >
    Call us now &middot; {CONTACT.phone}
    <span class="block text-xs font-normal opacity-90">Any time, day or night</span>
  </a>
</div>

<!-- Spacer so the fixed bar never covers the end of the page content. -->
<div aria-hidden="true" class="h-20 lg:hidden"></div>
