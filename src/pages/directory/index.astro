---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Callout from '../../components/Callout.astro';

const breadcrumbs = [{ name: 'Directory', url: '/directory/' }];

const [crematoria, cemeteries, registrars] = await Promise.all([
  getCollection('crematoria'),
  getCollection('cemeteries'),
  getCollection('registrars'),
]);

const sections = [
  {
    title: 'Crematoria',
    href: '/directory/crematoria/',
    count: crematoria.length,
    blurb:
      'Every crematorium serving East Lothian, the Borders and Edinburgh — the chapel, the capacity, the parking, whether they stream services, and what the place is actually like.',
  },
  {
    title: 'Cemeteries and burial grounds',
    href: '/directory/cemeteries/',
    count: cemeteries.length,
    blurb:
      'Council burial grounds and churchyards across East Lothian and Berwickshire, with who manages each one, how to enquire about a lair, and the memorial rules that apply.',
  },
  {
    title: 'Registration offices',
    href: '/directory/registrars/',
    count: registrars.length,
    blurb:
      'Where to register a death across East Lothian, Midlothian, Edinburgh and the Borders, with booking arrangements and what to take with you.',
  },
];
---

<Page
  title="Crematoria, Cemeteries & Registrars"
  heading="Crematoria, cemeteries and registrars"
  description="A reference directory of crematoria, burial grounds and registration offices across East Lothian, Midlothian, Edinburgh and the Scottish Borders."
  standfirst="Most of what families need to know is not really about funerals. It is about which office, which fee, and who to telephone. So we wrote it all down."
  breadcrumbs={breadcrumbs}
  wide={true}
>
  <div class="prose-jb">
    <p>
      This directory covers the whole of the east of Scotland, not only the area we serve.
      If you are arranging a funeral in Edinburgh or the Borders with a different funeral
      director, the information here is still yours to use — we would rather it existed
      somewhere than that families kept having to telephone round to find it.
    </p>
  </div>

  <ul class="mt-12 grid gap-8 md:grid-cols-3">
    {
      sections.map((section) => (
        <li class="flex flex-col border border-line bg-cream p-7">
          <h2 class="font-serif text-2xl">
            <a href={section.href} class="no-underline hover:underline">
              {section.title}
            </a>
          </h2>
          <p class="mt-1 text-sm text-ink-muted">{section.count} entries</p>
          <p class="mt-3 flex-1 text-ink-soft">{section.blurb}</p>
        </li>
      ))
    }
  </ul>

  <div class="prose-jb mt-16">
    <Callout title="Kept current, and dated so you can tell">
      <p>
        Every entry carries the date it was last checked. Fees, opening hours and
        facilities change — often each April — and a directory that does not say when it
        was written is worse than no directory at all. If you find something out of date,
        please <a href="/contact/">tell us</a> and we will correct it.
      </p>
    </Callout>

    <h2>Related</h2>
    <ul>
      <li><a href="/guides/">Our guides to funerals in Scotland</a></li>
      <li><a href="/someone-has-died/registering-a-death/">How to register a death</a></li>
      <li><a href="/bereavement-support/">Bereavement support in the east of Scotland</a></li>
    </ul>
  </div>
</Page>
