---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import DirectoryEntry from '../../../layouts/DirectoryEntry.astro';
import { clampDescription } from '../../../lib/seo';

export const getStaticPaths = (async () => {
  const registrars = await getCollection('registrars');
  return registrars.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const facts = [
  { label: 'Council', value: d.operator },
  {
    label: 'Appointments',
    value: d.appointmentOnly ? 'Required — you cannot turn up' : 'Walk-in accepted',
  },
  d.email ? { label: 'Email', value: d.email } : null,
  { label: 'Deadline', value: '8 days from the date of death' },
].filter((f): f is { label: string; value: string } => f !== null);

const schema = {
  '@type': 'GovernmentOffice',
  name: d.name,
  description: d.summary,
  address: {
    '@type': 'PostalAddress',
    streetAddress: d.street,
    addressLocality: d.locality,
    addressRegion: d.region,
    postalCode: d.postcode,
    addressCountry: 'GB',
  },
  ...(d.phone ? { telephone: d.phone } : {}),
  ...(d.email ? { email: d.email } : {}),
  ...(d.website ? { url: d.website } : {}),
};
---

<DirectoryEntry
  title={`Registering a Death in ${d.area}`}
  description={clampDescription(
    `${d.summary} Address, booking, what to take and how many certificates to buy.`
  )}
  standfirst={d.summary}
  breadcrumbs={[
    { name: 'Directory', url: '/directory/' },
    { name: 'Registration offices', url: '/directory/registrars/' },
    { name: d.name, url: `/directory/registrars/${entry.id}/` },
  ]}
  facts={facts}
  address={{
    street: d.street,
    locality: d.locality,
    region: d.region,
    postcode: d.postcode,
  }}
  phone={d.phone}
  website={d.website}
  lastVerified={d.lastVerified}
  schema={schema}
  backHref="/directory/registrars/"
  backLabel="All registration offices"
>
  <Content />
</DirectoryEntry>
