---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import DirectoryEntry from '../../../layouts/DirectoryEntry.astro';
import { clampDescription } from '../../../lib/seo';
import FeeSheet from '../../../components/FeeSheet.astro';
import { CEMETERY_FEES } from '../../../data/thirdPartyFees';

export const getStaticPaths = (async () => {
  const cemeteries = await getCollection('cemeteries');
  return cemeteries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const fees = CEMETERY_FEES[entry.id];

const facts = [
  { label: 'Type', value: d.type },
  { label: 'Managed by', value: d.operator },
  {
    label: 'Natural burial',
    value: d.allowsNaturalBurial ? 'Permitted' : 'Not available here',
  },
  d.acceptsNewLairs !== undefined
    ? {
        label: 'New lairs',
        value: d.acceptsNewLairs ? 'Available' : 'Existing lairs only',
      }
    : null,
].filter((f): f is { label: string; value: string } => f !== null);

const schema = {
  '@type': 'Cemetery',
  name: d.name,
  description: d.summary,
  address: {
    '@type': 'PostalAddress',
    streetAddress: d.street,
    addressLocality: d.locality,
    addressRegion: d.region,
    postalCode: d.postcode,
    addressCountry: 'GB',
  },
  ...(d.phone ? { telephone: d.phone } : {}),
  ...(d.website ? { url: d.website } : {}),
};
---

<DirectoryEntry
  title={`${d.name} — Lairs & Memorials`}
  description={clampDescription(
    `${d.summary} Lairs, interments, memorial rules and who to contact.`
  )}
  standfirst={d.summary}
  breadcrumbs={[
    { name: 'Directory', url: '/directory/' },
    { name: 'Cemeteries', url: '/directory/cemeteries/' },
    { name: d.name, url: `/directory/cemeteries/${entry.id}/` },
  ]}
  facts={facts}
  address={{
    street: d.street,
    locality: d.locality,
    region: d.region,
    postcode: d.postcode,
  }}
  phone={d.phone}
  website={d.website}
  lastVerified={d.lastVerified}
  schema={schema}
  backHref="/directory/cemeteries/"
  backLabel="All cemeteries"
>
  <Content />
  {
    fees ? (
      <FeeSheet sheet={fees} />
    ) : (
      <>
        <h2>Fees</h2>
        <p>
          We do not yet show this cemetery's fees here. Please ask us, or check with them directly.
          Our <a href="/funeral-costs/third-party-fees/">fees page</a> lists the ones we have.
        </p>
      </>
    )
  }
</DirectoryEntry>
