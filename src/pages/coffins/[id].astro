---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Callout from '../../components/Callout.astro';
import { Image } from 'astro:assets';
import { CONTACT } from '../../data/site';
import { clampDescription } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const coffins = await getCollection('coffins');
  return coffins.map((coffin) => ({ params: { id: coffin.id }, props: { coffin } }));
}) satisfies GetStaticPaths;

const { coffin } = Astro.props;
const { Content } = await render(coffin);

const breadcrumbs = [
  { name: 'Coffins', url: '/coffins/' },
  { name: coffin.data.name, url: `/coffins/${coffin.id}/` },
];

// "Traditional Wooden Coffins Coffin" — only add the keyword where the name
// does not already carry it.
const named = /coffin|urn|shroud|casket/i.test(coffin.data.name);
const seoTitle = named ? coffin.data.name : `${coffin.data.name} Coffins`;

const schema = {
  '@type': 'Product',
  name: coffin.data.name,
  description: coffin.data.summary,
  material: coffin.data.material,
  brand: { '@type': 'Brand', name: 'Ecoffins' },
};
---

<Page
  title={seoTitle}
  heading={coffin.data.name}
  description={clampDescription(
    `${coffin.data.summary} Supplied by John Bald Funeral Directors in Dunbar.`
  )}
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  {
    coffin.data.image && (
      <figure class="mb-8">
        <Image
          src={coffin.data.image}
          alt={coffin.data.imageAlt!}
          widths={[480, 800, 1200]}
          sizes="(min-width: 68ch) 68ch, 100vw"
          class="w-full border border-line"
          loading="eager"
        />
        {coffin.data.imageCredit && (
          <figcaption class="mt-2 text-sm text-ink-muted">
            {coffin.data.imageCredit}
          </figcaption>
        )}
      </figure>
    )
  }

  <dl class="mb-8 grid gap-x-8 gap-y-3 border-y border-line py-5 sm:grid-cols-2">
    <div>
      <dt class="text-sm uppercase tracking-widest text-ink-muted">Material</dt>
      <dd class="mt-1">{coffin.data.material}</dd>
    </div>
    <div>
      <dt class="text-sm uppercase tracking-widest text-ink-muted">Suitable for</dt>
      <dd class="mt-1">{coffin.data.suitableFor.join(', ')}</dd>
    </div>
    <div>
      <dt class="text-sm uppercase tracking-widest text-ink-muted">Biodegradable</dt>
      <dd class="mt-1">{coffin.data.biodegradable ? 'Yes, fully' : 'No'}</dd>
    </div>
    <div>
      <dt class="text-sm uppercase tracking-widest text-ink-muted">Price</dt>
      <dd class="mt-1">
        {
          coffin.data.indicativePrice === null
            ? 'Please ask — we will tell you straight away'
            : `From £${coffin.data.indicativePrice.toLocaleString('en-GB')}`
        }
      </dd>
    </div>
  </dl>

  <Content />

  <Callout tone="accent" title="To choose this coffin">
    <p>
      Telephone <a href={CONTACT.phoneHref} class="font-semibold">{CONTACT.phone}</a> or{' '}
      <a href="/contact/">send us a message</a>. We will confirm the price and arrange it
      for you — coffins are supplied through funeral directors rather than bought
      directly.
    </p>
  </Callout>

  <p><a href="/coffins/">← Back to all coffins</a></p>
</Page>
